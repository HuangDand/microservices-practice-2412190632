MYSQL_ROOT_PASSWORD=root123
MYSQL_PASSWORD=course123
# Nacos 凭据：用 openssl rand -base64 32 生成 Auth Token
NACOS_AUTH_TOKEN=replace-with-base64-secret
NACOS_AUTH_IDENTITY_KEY=courseServerIdentity
# 用 openssl rand -hex 16 生成随机身份值
NACOS_AUTH_IDENTITY_VALUE=replace-with-hex-16-value
# 首次登录 Nacos 控制台后设置的管理员密码，与应用访问注册中心的密码相同
NACOS_PASSWORD=set-your-admin-password
