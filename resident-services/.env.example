# 复制为 .env 后按需修改；此处只放占位值，真实密码/Token 不入库
RESIDENT_DB_PASSWORD=resident-pass-123
RESIDENT_DB_ROOT_PASSWORD=resident-root-123
REPAIR_DB_PASSWORD=repair-pass-123
REPAIR_DB_ROOT_PASSWORD=repair-root-123
NOTICE_DB_PASSWORD=notice-pass-123
NOTICE_DB_ROOT_PASSWORD=notice-root-123

# Nacos 鉴权：Token 必须是 >=32 字节原文的 Base64；identity 为服务端互通凭据
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos-password
NACOS_AUTH_TOKEN=cmVwbGFjZS13aXRoLTMyLWJ5dGVzLWJhc2U2NC1zZWNyZXQta2V5IQ==
NACOS_AUTH_IDENTITY_KEY=change-me-identity-key
NACOS_AUTH_IDENTITY_VALUE=change-me-identity-value
